# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/
.coverage
htmlcov/

# secrets
.env

# generated reports and scratch
/reports/
# ...but the schedule aggregates are the published evidence behind docs/BASELINE_RESULTS.md,
# and reports/ is otherwise untracked while the DVC remote is a local placeholder.
!/reports/protocol/
!/reports/protocol/*/
!/reports/protocol/*/eval/
!/reports/protocol/*/eval/schedule-*.json
.scratch/

# DVC-managed directories (contents tracked by .dvc files / dvc.yaml outs)
/data/raw/**
/data/interim/**
# ...but keep the directories walkable and track DVC pointers, DVC-written .gitignore files and
# the provenance/manifest sidecars that describe what was fetched (contents stay DVC-only)
!/data/raw/**/
!/data/interim/**/
!/data/raw/**/*.dvc
!/data/interim/**/*.dvc
!/data/raw/**/.gitignore
!/data/interim/**/.gitignore
!/data/raw/**/manifest.json
!/data/interim/**/manifest.json
!/data/raw/**/provenance.json
!/data/interim/**/provenance.json
!/data/interim/**/*.provenance.json
/data/catalogs/
/data/forecasts/
# ETAS fits are outputs of the dvc.yaml `fit_etas` stages (DVC-tracked, not git-tracked).
# The fitted parameters are published for review in docs/ETAS_BASELINE.md.
/baselines/etas/
# Gridded challenger fits (C1b): model weights and normalisation state, the same kind of
# artefact as an ETAS fit. The fitted parameters and scores are published in
# docs/CHALLENGER_GRIDDED.md and reports/MODEL_CARD_gridded.md.
/baselines/gridded/
/baselines/**/*.parquet
/baselines/**/*.zarr
/baselines/**/*.pt

# OS / editors
.DS_Store
.idea/
.vscode/
.dvc/local-remote/
