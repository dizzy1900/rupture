# rupture — environment. Copy to .env (never committed). See docs/CREDENTIALS.md.
# Nothing here is required for the offline test suite.

# Optional: DVC remote (S3 or local path). Leave empty to use the local placeholder remote.
RUPTURE_DVC_REMOTE_URL=

# Optional: AWS credentials for the DVC remote and infra/jobs manifests.
AWS_PROFILE=
AWS_REGION=

# Optional: contact e-mail sent in FDSN/ComCat User-Agent headers (polite identification, not auth).
RUPTURE_CONTACT_EMAIL=

# Optional: path to a manually downloaded ISC-GEM catalogue CSV (form-gated download).
RUPTURE_ISC_GEM_CSV=

# Optional: OpenQuake engine image override. Default is the pinned tag in the adapter.
RUPTURE_OPENQUAKE_IMAGE=
