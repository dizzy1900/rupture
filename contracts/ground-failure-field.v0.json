{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dizzy1900/rupture/contracts/ground-failure-field.v0.json",
  "$defs": {
    "CascadeKind": {
      "enum": [
        "landslide",
        "liquefaction",
        "ice_rock_avalanche"
      ],
      "title": "CascadeKind",
      "type": "string"
    },
    "GroundFailureCell": {
      "additionalProperties": false,
      "description": "One grid cell of a ground-failure model output.",
      "properties": {
        "longitude": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Longitude",
          "type": "number"
        },
        "latitude": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Latitude",
          "type": "number"
        },
        "probability": {
          "description": "P(failure) or areal fraction.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        },
        "areal_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Areal Coverage"
        }
      },
      "required": [
        "longitude",
        "latitude",
        "probability"
      ],
      "title": "GroundFailureCell",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a record came from. Required on every ingested row and every derived product.\n\n``licence`` is the upstream licence identifier (SPDX where one exists, otherwise the\nprovider's own terms label). ``sha256`` is the digest of the raw payload the record was\nparsed from, so a re-fetch can be compared byte-for-byte. Unknowns are ``None``, never guessed.",
      "properties": {
        "source": {
          "description": "Provider/catalogue identifier, e.g. 'usgs-comcat', 'isc', 'gcmt'.",
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact URL or file path the payload came from.",
          "title": "Source Url"
        },
        "retrieved_at": {
          "description": "When the payload was fetched (UTC).",
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digest of the raw payload, hex.",
          "title": "Sha256"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upstream licence (SPDX id or provider terms label).",
          "title": "Licence"
        },
        "adapter_version": {
          "description": "Version of the rupture adapter that parsed the payload.",
          "title": "Adapter Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source",
        "retrieved_at",
        "adapter_version"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A gridded ground-failure susceptibility product for one event or scenario.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/CascadeKind"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "model_id": {
      "description": "e.g. 'nowicki_jessee_2018', 'zhu_2017_coastal'.",
      "title": "Model Id",
      "type": "string"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/GroundFailureCell"
      },
      "minItems": 1,
      "title": "Cells",
      "type": "array"
    },
    "cell_size_deg": {
      "exclusiveMinimum": 0.0,
      "title": "Cell Size Deg",
      "type": "number"
    },
    "shaking_source": {
      "description": "ShakeMap grid id, or the GroundMotionField id.",
      "title": "Shaking Source",
      "type": "string"
    },
    "computed_at": {
      "format": "date-time",
      "title": "Computed At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "source_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "id",
    "kind",
    "scenario_id",
    "model_id",
    "model_version",
    "cells",
    "cell_size_deg",
    "shaking_source",
    "computed_at",
    "provenance"
  ],
  "title": "GroundFailureField",
  "type": "object"
}
