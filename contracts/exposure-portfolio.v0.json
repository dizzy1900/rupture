{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dizzy1900/rupture/contracts/exposure-portfolio.v0.json",
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "longitude": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Longitude",
          "type": "number"
        },
        "latitude": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Latitude",
          "type": "number"
        },
        "taxonomy": {
          "description": "GEM taxonomy string or a consumer-defined class.",
          "title": "Taxonomy",
          "type": "string"
        },
        "value": {
          "description": "Replacement value in the portfolio currency.",
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        },
        "occupants": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupants"
        },
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "id",
        "longitude",
        "latitude",
        "taxonomy",
        "value"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a record came from. Required on every ingested row and every derived product.\n\n``licence`` is the upstream licence identifier (SPDX where one exists, otherwise the\nprovider's own terms label). ``sha256`` is the digest of the raw payload the record was\nparsed from, so a re-fetch can be compared byte-for-byte. Unknowns are ``None``, never guessed.",
      "properties": {
        "source": {
          "description": "Provider/catalogue identifier, e.g. 'usgs-comcat', 'isc', 'gcmt'.",
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact URL or file path the payload came from.",
          "title": "Source Url"
        },
        "retrieved_at": {
          "description": "When the payload was fetched (UTC).",
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digest of the raw payload, hex.",
          "title": "Sha256"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upstream licence (SPDX id or provider terms label).",
          "title": "Licence"
        },
        "adapter_version": {
          "description": "Version of the rupture adapter that parsed the payload.",
          "title": "Adapter Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source",
        "retrieved_at",
        "adapter_version"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "currency": {
      "description": "ISO 4217.",
      "maxLength": 3,
      "minLength": 3,
      "title": "Currency",
      "type": "string"
    },
    "valuation_date": {
      "format": "date-time",
      "title": "Valuation Date",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "id",
    "currency",
    "valuation_date",
    "assets",
    "provenance"
  ],
  "title": "ExposurePortfolio",
  "type": "object"
}
